generator client {
  provider      = "prisma-client"
  output        = "../lib/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // For dev, if you see P2024 (connection pool timeout), add ?connection_limit=5 to DATABASE_URL
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      UserRole @default(CHEF)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

/// UI + route capability keys (e.g. `module.kitchen-planning`). Assigned to roles via `RolePermission`.
model Permission {
  id    Int    @id @default(autoincrement())
  key   String @unique
  name  String
  roles RolePermission[]

  @@index([key])
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  role         UserRole
  permissionId Int
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
  @@index([role])
}

model Dish {
  id                      Int                      @id @default(autoincrement())
  name                    String
  description             String?
  category                DishCategory
  ingredients             String?
  allergens               String?
  calories                Int
  protein                 Float
  carbs                   Float
  fats                    Float
  price                   Float?
  status                  String                   @default("ACTIVE")
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  mealPlanItems           MealPlanItem[]
  mealPlanTemplateItems   MealPlanTemplateItem[]

  @@index([category])
  @@index([status])
  @@index([name])
}

/// Reusable labeled **week menu** (Mon–Sun by row): optimized for copying onto customer weekly meal plans.
/// `planType` and `days` describe contract metadata (today: weekly + 7 days is typical); monthly/custom kept for longer-term longer contracts.
model MealPlanTemplate {
  id             Int                      @id @default(autoincrement())
  label          String
  planType       PlanType
  days           Int
  mealsPerDay    Int
  timeSlots      Json?
  weeklySkipDays Int[]                    @default([])
  notes          String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  items          MealPlanTemplateItem[]

  @@index([label])
}

model MealPlanTemplateItem {
  id              Int              @id @default(autoincrement())
  templateId      Int
  /// Calendar weekday: **1 = Monday … 7 = Sunday** (same as `weeklySkipDays` / `WEEKDAY_SKIP_TOGGLES`).
  /// Same pattern repeats each calendar week on customers; per-week-of-month variants could be added later if needed.
  weekday         Int
  /// 0-based meal index for that weekday (matches time-slot order for that day).
  slotIndex       Int
  isSkipped       Boolean          @default(false)
  dishId          Int?
  dishName        String?
  dishDescription String?
  dishCategory    DishCategory?
  ingredients     String?
  allergens       String?
  calories        Int?
  protein         Float?
  carbs           Float?
  fats            Float?
  price           Float?
  customNote      String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  template        MealPlanTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  dish            Dish?            @relation(fields: [dishId], references: [id])

  @@unique([templateId, weekday, slotIndex])
  @@index([templateId])
}

model Customer {
  id           Int             @id @default(autoincrement())
  fullName     String
  phone        String
  email        String?
  address      String
  deliveryArea String
  status       CustomerStatus  @default(ACTIVE)
  notes        String?
  /** Kitchen / delivery alerts (allergies, no fish, etc.) — shown prominently on customer and meal plan views */
  instructions String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  mealPlans    MealPlan[]
  payments     Payment[]
  locations    CustomerLocation[]
  whatsappConversations WhatsAppConversation[]
  whatsappAgentRuns     WhatsAppAgentRun[]
  whatsappPendingActions WhatsAppPendingAction[]

  @@index([status])
  @@index([deliveryArea])
  @@index([phone])
  @@index([fullName])
}

/// Saved delivery places for a customer (e.g. Home, Work). Meal items link here in a later step.
model CustomerLocation {
  id           Int      @id @default(autoincrement())
  customerId   Int
  label        String
  icon         String   @default("home")
  address      String
  deliveryArea String
  isDefault    Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  customer     Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  mealPlanItems MealPlanItem[]

  @@unique([customerId, label])
  @@index([customerId])
}

model Plan {
  id          Int        @id @default(autoincrement())
  name        String
  planType    PlanType
  days        Int
  mealsPerDay Int
  /// Contract slots for the template: days × mealsPerDay (kept in sync on create/update)
  totalMeals  Int        @default(0)
  price       Float
  description String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  mealPlans   MealPlan[]
  payments    Payment[]

  @@index([isActive])
}

model MealPlan {
  id              Int             @id @default(autoincrement())
  customerId      Int
  planId          Int?
  startDate       DateTime?
  endDate         DateTime?
  mealsPerDay     Int
  status          String         @default("ACTIVE")
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  averageMealRate Float?
  baseAmount      Float?
  days            Int
  planType        PlanType
  remainingMeals  Int?
  totalAmount     Float?
  totalMeals      Int?
  vatAmount       Float?
  /// Delivery time labels per day, e.g. ["08:00","13:00","19:00"] — copied to each new MealPlanItem unless overridden
  timeSlots       Json?
  /// Weekdays to skip (Mon=1 … Sun=7): plan-wide default for new weeks and weeks without a `weeklySkipDaysByWeek` entry
  weeklySkipDays               Int[]   @default([])
  /// JSON map plan week number (string) → weekday list (1–7), e.g. `{"1":[6,7],"2":[7]}` — overrides plan default per week
  weeklySkipDaysByWeek         Json?
  customer                     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  plan            Plan?          @relation(fields: [planId], references: [id])
  mealPlanItems   MealPlanItem[]
  payments        Payment[]
  history         MealPlanHistory[]
  whatsappAgentRuns WhatsAppAgentRun[]
  whatsappPendingActions WhatsAppPendingAction[]

  @@index([customerId])
  @@index([startDate])
  @@index([endDate])
  @@index([status])
  @@index([planType])
}

/// Append-only meal plan timeline (counts after each event) for debugging balance / schedule drift.
model MealPlanHistory {
  id         Int      @id @default(autoincrement())
  mealPlanId Int
  createdAt  DateTime @default(now())

  action      String
  summary     String?
  itemId      Int?
  actorUserId Int?
  requestId   String?
  details     Json?

  totalMeals         Int?
  remainingMeals     Int?
  days               Int?
  mealsPerDay        Int?
  activeCount        Int @default(0)
  inactiveCount      Int @default(0)
  deliveredCount     Int @default(0)
  skippedCount       Int @default(0)
  wrongDeliveryCount Int @default(0)
  scheduledCount     Int @default(0)

  remainingBefore Int?
  remainingAfter  Int?
  deliveredBefore Int?
  deliveredAfter  Int?
  activeBefore    Int?
  activeAfter     Int?
  inactiveBefore  Int?
  inactiveAfter   Int?

  mealPlan MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)

  @@index([mealPlanId, createdAt])
  @@index([action, createdAt])
  @@index([requestId])
}

model MealPlanItem {
  id               Int          @id @default(autoincrement())
  mealPlanId       Int
  dishId           Int?
  date             DateTime
  timeSlot         String
  isSkipped        Boolean      @default(false)
  customNote       String?      // Plain text note only (no JSON)
  deliveryType         String?           // 'delivery' | 'pickup'
  /// Delivery area snapshot when marked delivered (live: use customerLocation)
  deliveredLocation    String?
  /// Full address snapshot when marked delivered (live: use customerLocation)
  deliveredAddress     String?
  customerLocationId   Int?
  customerLocation     CustomerLocation? @relation(fields: [customerLocationId], references: [id], onDelete: SetNull)
  createdAt            DateTime          @default(now())
  updatedAt        DateTime     @updatedAt
  isDelivered      Boolean      @default(false)
  /// Marked when delivery was incorrect; not counted toward remaining balance (isDelivered cleared)
  wrongDelivery    Boolean      @default(false)
  deliveredAt      DateTime?
  allergens        String?
  calories         Int?
  carbs            Float?
  deliveryTime     String?
  dishCategory     DishCategory?
  dishDescription  String?
  dishName         String?
  fats             Float?
  ingredients      String?
  price            Float?
  protein          Float?
  dish             Dish?        @relation(fields: [dishId], references: [id])
  mealPlan         MealPlan     @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)

  @@index([mealPlanId])
  @@index([date])
  @@index([timeSlot])
  @@index([dishId])
  @@index([dishCategory])
  @@index([customerLocationId])
}

model Payment {
  id            Int        @id @default(autoincrement())
  customerId    Int
  mealPlanId    Int?
  planId        Int?
  amount        Float
  paymentDate   DateTime   @default(now())
  paymentMethod String?
  status        String     @default("PENDING")
  notes         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  customer      Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  mealPlan      MealPlan?  @relation(fields: [mealPlanId], references: [id])
  plan          Plan?      @relation(fields: [planId], references: [id])

  @@index([customerId])
  @@index([mealPlanId])
  @@index([paymentDate])
  @@index([status])
}

model WhatsAppConversation {
  id                 Int                @id @default(autoincrement())
  /// Meta `wa_id` style: digits only, e.g. 971501234567
  phoneE164          String             @unique
  customerId         Int?
  contactName        String?
  lastMessageAt      DateTime
  lastMessagePreview String?
  unreadCount        Int                @default(0)
  /// When MANUAL, the meal agent does not auto-process inbound messages.
  agentMode          WhatsAppAgentMode  @default(AUTO)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  customer           Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  messages           WhatsAppMessage[]
  agentRuns          WhatsAppAgentRun[]
  pendingActions     WhatsAppPendingAction[]

  @@index([lastMessageAt])
  @@index([customerId])
}

model WhatsAppMessage {
  id             Int                      @id @default(autoincrement())
  conversationId Int
  externalId     String?                  @unique
  direction      WhatsAppMessageDirection
  messageType    String                   @default("text")
  body           String?
  status         WhatsAppMessageStatus    @default(RECEIVED)
  timestamp      DateTime
  rawPayload     Json?
  createdAt      DateTime                 @default(now())
  conversation   WhatsAppConversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  agentRuns      WhatsAppAgentRun[]

  @@index([conversationId])
  @@index([timestamp])
}

/// One automated processing pass (inbound message, cron, or manual retry).
model WhatsAppAgentRun {
  id               Int                    @id @default(autoincrement())
  conversationId   Int?
  customerId       Int?
  mealPlanId       Int?
  inboundMessageId Int?
  parentRunId      Int?
  pendingActionId  Int?
  trigger          WhatsAppAgentTrigger
  status           WhatsAppAgentRunStatus
  rawMessageBody   String?
  parsedIntent     Json?
  model            String?
  modelRawResponse Json?
  errorMessage     String?
  payload          Json?
  createdAt        DateTime               @default(now())
  conversation     WhatsAppConversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  customer         Customer?              @relation(fields: [customerId], references: [id], onDelete: SetNull)
  mealPlan         MealPlan?              @relation(fields: [mealPlanId], references: [id], onDelete: SetNull)
  inboundMessage   WhatsAppMessage?       @relation(fields: [inboundMessageId], references: [id], onDelete: SetNull)
  parentRun        WhatsAppAgentRun?      @relation("AgentRunFollowUp", fields: [parentRunId], references: [id], onDelete: SetNull)
  followUpRuns     WhatsAppAgentRun[]     @relation("AgentRunFollowUp")
  pendingAction    WhatsAppPendingAction? @relation(fields: [pendingActionId], references: [id], onDelete: SetNull)
  actions          WhatsAppAgentAction[]

  @@index([conversationId])
  @@index([customerId])
  @@index([mealPlanId])
  @@index([inboundMessageId])
  @@index([status])
  @@index([createdAt])
}

model WhatsAppAgentAction {
  id             Int              @id @default(autoincrement())
  runId          Int
  actionType     String
  status         String
  input          Json?
  output         Json?
  confidence     Float?
  beforeSnapshot Json?
  afterSnapshot  Json?
  createdAt      DateTime         @default(now())
  run            WhatsAppAgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([actionType])
}

/// Multi-turn state: dish choice, batch clarifications, replace meal.
model WhatsAppPendingAction {
  id               Int                         @id @default(autoincrement())
  conversationId   Int
  customerId       Int?
  mealPlanId       Int?
  createdFromRunId Int?
  type             WhatsAppPendingActionType
  status           WhatsAppPendingActionStatus @default(OPEN)
  context          Json
  expiresAt        DateTime
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  conversation     WhatsAppConversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  customer         Customer?                   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  mealPlan         MealPlan?                   @relation(fields: [mealPlanId], references: [id], onDelete: SetNull)
  agentRuns        WhatsAppAgentRun[]

  @@index([conversationId])
  @@index([status])
  @@index([expiresAt])
}

enum WhatsAppMessageDirection {
  INBOUND
  OUTBOUND
}

enum WhatsAppMessageStatus {
  RECEIVED
  SENT
  DELIVERED
  READ
  FAILED
}

enum WhatsAppAgentMode {
  AUTO
  MANUAL
}

enum WhatsAppAgentTrigger {
  INBOUND_MESSAGE
  CRON_REMINDER
  MANUAL
}

enum WhatsAppAgentRunStatus {
  SUCCESS
  PARTIAL
  FAILED
  NEEDS_CONFIRMATION
  SKIPPED
}

enum WhatsAppPendingActionStatus {
  OPEN
  COMPLETED
  CANCELLED
  EXPIRED
}

enum WhatsAppPendingActionType {
  DISH_CHOICE
  MEAL_BATCH
  REPLACE_MEAL
}

enum UserRole {
  ADMIN
  MANAGER
  CHEF
  /// Limited staff (e.g. kitchen ops) — grant modules via `RolePermission`, not full manager APIs.
  OPERATIONS
}

enum DishCategory {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
  SMOOTHIE
  JUICE
  LUNCH_DINNER
}

enum PlanType {
  WEEKLY
  MONTHLY
  CUSTOM
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  PAUSED
  CANCELLED
}
