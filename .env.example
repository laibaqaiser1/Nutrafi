# Copy to .env and fill in values. Do not commit real tokens.

# WhatsApp Cloud API (Meta)
WHATSAPP_ACCESS_TOKEN=
# Phone number ID from API Setup (GET returns display_phone_number) — NOT the WABA id (returns name + message_template_namespace)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v25.0
# Random string you choose — must match Meta webhook "Verify token"
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Webhook callback URL (configure in Meta app → WhatsApp → Configuration):
# https://YOUR_DOMAIN/api/whatsapp/webhook
#
# Production checklist (Meta):
# 1. Publish the Meta app (unpublished apps only get dashboard test webhooks)
# 2. Subscribe WABA to app: POST /{WABA_ID}/subscribed_apps (WABA id ≠ phone number id)
# 3. Webhook fields: messages (+ message_echoes if using Business app coexistence)

# WhatsApp meal agent (separate from dashboard meal-plan APIs)
# Optional: WHATSAPP_AGENT_ENABLED=false to disable (default: on)
WHATSAPP_CUSTOMER_SUPPORT_PHONE=971000000000
# Required in production — OpenAI extracts intent + meal details from free-form messages.
OPENAI_API_KEY=
# Optional tuning (defaults in code): OPENAI_MODEL, WHATSAPP_AGENT_REQUIRE_OPENAI
# Speed: rules-first parsing is default; set WHATSAPP_AGENT_OPENAI_DISH_PICK=true only if you want an extra OpenAI call when dish match is ambiguous
# WHATSAPP_AGENT_OPENAI_DISH_PICK=false
# Cron reminders (tomorrow's meals) — REQUIRED on Vercel for scheduled reminders to run.
# Set a long random string. Vercel Cron sends Authorization: Bearer <CRON_SECRET>.
# Easiest: use the SAME value for both WHATSAPP_AGENT_CRON_SECRET and CRON_SECRET in Vercel env.
# Also required so inbound WhatsApp webhooks can dispatch the agent worker (without it, agent work may time out).
WHATSAPP_AGENT_CRON_SECRET=
# Pilot only: comma-separated customer IDs. Leave EMPTY to remind all eligible customers.
# If set, only these IDs receive reminders — cron still runs but may send 0 messages.
WHATSAPP_AGENT_CRON_REMINDER_CUSTOMER_IDS=
# Vercel auto-injects CRON_SECRET when vercel.json crons exist — copy the same value as WHATSAPP_AGENT_CRON_SECRET.
# CRON_SECRET=
# Optional: WHATSAPP_AGENT_DEBUG_TIMING=true — logs step timings in Vercel/server logs
# Menu PDF for WhatsApp (defaults to /menu/nutrafi-menu.pdf on your app domain after deploy)
# WHATSAPP_AGENT_MENU_PDF_URL=https://your-domain.com/menu/nutrafi-menu.pdf
# WHATSAPP_AGENT_MENU_PDF_FILENAME=Nutrafi Kitchen Menu.pdf
